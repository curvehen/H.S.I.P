        "            for r in reasons:\n",
        "                print(f\"      {r}\")\n",
        "            print(f\"\\n   🤖 AI分析:\")\n",
        "            print(f\"   {ai_result.replace(chr(10), chr(10)+'   ')}\")\n",
        "        else:\n",
        "            print(f\"   {' | '.join(reasons)}\")\n",
        "\n",
        "        backtest_records.append({\n",
        "            \"time\"        : sim_time_str,\n",
        "            \"session\"     : session,\n",
        "            \"signal\"      : signal,\n",
        "            \"score\"       : score,\n",
        "            \"price\"       : round(price, 1),\n",
        "            \"vwap\"        : round(vwap, 1),\n",
        "            \"action\"      : action,\n",
        "            \"stop_loss\"   : sl,\n",
        "            \"take_profit\" : tp,\n",
        "            \"ai_called\"   : call_ai,\n",
        "            \"trigger_type\": trigger_type if call_ai else \"-\",\n",
        "            \"sudden\"      : sudden_reason if is_sudden else \"-\",\n",
        "        })\n",
        "\n",
        "        if speed == \"slow\":\n",
        "            time_module.sleep(3)\n",
        "\n",
        "    # ── 最終總結 ──\n",
        "    print(f\"\\n{'='*60}\")\n",
        "    print(f\"📊 BACKTEST結果 — {target_date}\")\n",
        "    print(f\"{'='*60}\")\n",
        "\n",
        "    if actual_detail:\n",
        "        print(f\"\\n✅ 實際下午走勢:\")\n",
        "        print(f\"   早市收市價:  {actual_detail['morning_close']:.0f}\")\n",
        "        print(f\"   下午最高:    {actual_detail['afternoon_high']:.0f}\")\n",
        "        print(f\"   下午最低:    {actual_detail['afternoon_low']:.0f}\")\n",
        "        print(f\"   下午收市價:  {actual_detail['afternoon_close']:.0f}\")\n",
        "        print(f\"   變動:        {actual_pct:+.2f}%\")\n",
        "        print(f\"   實際信號:    {actual_signal}\")\n",
        "\n",
        "    df_bt = pd.DataFrame(backtest_records)\n",
        "    ai_calls       = df_bt[df_bt[\"ai_called\"] == True]\n",
        "    sudden_calls   = df_bt[df_bt[\"trigger_type\"] == \"突變\"]\n",
        "    scheduled_calls= df_bt[df_bt[\"trigger_type\"] == \"定時\"]\n",
        "\n",
        "    print(f\"\\n📊 AI調用統計:\")\n",
