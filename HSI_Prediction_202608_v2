        "                        random_state    = 42,\n",
        "                        min_covar       = 1e-3,\n",
        "                    )\n",
        "                    m.fit(obs)\n",
        "                    _             = m.predict(obs)\n",
        "                    self.model    = m\n",
        "                    self.n_states = n_st\n",
        "                    means         = m.means_[:, 0]\n",
        "                    rank          = np.argsort(means)\n",
        "                    if n_st == 3:\n",
        "                        self.state_map = {\n",
        "                            rank[0]: \"bear\",\n",
        "                            rank[1]: \"neutral\",\n",
        "                            rank[2]: \"bull\",\n",
        "                        }\n",
        "                    else:\n",
        "                        self.state_map = {\n",
        "                            rank[0]: \"bear\",\n",
        "                            rank[1]: \"bull\",\n",
        "                        }\n",
        "                    self.fitted = True\n",
        "                    print(f\"  HMM fit OK (ENH#6 6-dim): \"\n",
        "                          f\"n_states={n_st}, cov={cov}\")\n",
        "                    return self\n",
        "                except Exception as e:\n",
        "                    print(f\"  HMM WARN: n_states={n_st}, \"\n",
        "                          f\"cov={cov} → {str(e)[:40]}\")\n",
        "                    continue\n",
        "        print(\"  HMM 完全失敗 → 標記 fitted=False\")\n",
        "        self.fitted = False\n",
        "        return self\n",
        "\n",
        "    def add_features(self, df: pd.DataFrame) -> pd.DataFrame:\n",
        "        df = df.copy()\n",
        "        try:\n",
        "            if not self.fitted or self.model is None:\n",
        "                raise AttributeError(\"HMM 未 fit\")\n",
        "            obs      = self._obs(df)\n",
        "            states   = self.model.predict(obs)\n",
        "            _, post  = self.model.score_samples(obs)\n",
        "            df[\"hmm_state\"]  = states\n",
        "            df[\"hmm_regime\"] = (\n",
        "                pd.Series(states, index=df.index)\n",
        "                .map(self.state_map)\n",
        "                .fillna(\"neutral\")\n",
        "                .values\n",
        "            )\n",
        "            for label in [\"bear\", \"neutral\", \"bull\"]:\n",
        "                state_id = [k for k, v in self.state_map.items()\n",
        "                            if v == label]\n",
        "                if state_id and post.shape[1] > state_id[0]:\n",
        "                    df[f\"hmm_prob_{label}\"] = post[:, state_id[0]]\n",
        "                else:\n",
        "                    df[f\"hmm_prob_{label}\"] = 1 / self.n_states\n",
        "        except Exception as e:\n",
        "            print(f\"  WARN HMM add_features 失敗: {e}\")\n",
        "            print(f\"  → 使用簡單規則代替\")\n",
        "            df = self._simple_regime(df)\n",
        "        return df\n",
        "\n",
