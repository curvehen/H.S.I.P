        "\n",
        "stock_data    = {}\n",
        "failed_stocks = []\n",
        "\n",
        "def download_stock(ticker: str, name: str) -> pd.DataFrame | None:\n",
        "    \"\"\"下載單隻股票，自動補充盤中數據（情境3）\"\"\"\n",
        "\n",
        "    # ── Step A: 下載日線數據 ─────────────────────────────\n",
        "    try:\n",
        "        tkr = yf.Ticker(ticker)\n",
        "        df  = tkr.history(\n",
        "            start       = STOCK_TRAIN_START,\n",
        "            end         = DOWNLOAD_END,        # today+2\n",
        "            auto_adjust = True,\n",
        "            timeout     = 30,\n",
        "        )\n",
        "    except Exception as e:\n",
        "        print(f\"  ❌ {name} ({ticker}) 下載失敗: {e}\")\n",
        "        return None\n",
        "\n",
        "    if df is None or len(df) < STOCK_MIN_HISTORY:\n",
        "        print(f\"  ⚠️  {name} ({ticker}): \"\n",
        "              f\"數據不足（{0 if df is None else len(df)} 行）\")\n",
        "        return None\n",
        "\n",
        "    df = df.reset_index()\n",
        "\n",
        "    # ── Step B: 標準化欄位 ───────────────────────────────\n",
        "    date_col = next(\n",
        "        (c for c in df.columns if \"date\" in str(c).lower()), None\n",
        "    )\n",
        "    if date_col is None:\n",
        "        print(f\"  ⚠️  {name} 無日期欄位\")\n",
        "        return None\n",
        "\n",
        "    df[date_col] = pd.to_datetime(df[date_col]).dt.tz_localize(None)\n",
        "    df = df.rename(columns={date_col: \"date\"})\n",
        "\n",
        "    col_map = {}\n",
        "    for c in df.columns:\n",
        "        cl = c.lower()\n",
        "        if \"open\"   in cl: col_map[c] = \"open\"\n",
        "        elif \"high\"  in cl: col_map[c] = \"high\"\n",
