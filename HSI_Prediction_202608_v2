        "\n",
        "    # ── 52 週高低位 ───────────────────────────────────────────\n",
        "    _h = df[\"high\"] if \"high\" in df.columns else close\n",
        "    _l = df[\"low\"]  if \"low\"  in df.columns else close\n",
        "    df[\"high_52w\"]     = _h.rolling(252, min_periods=60).max()\n",
        "    df[\"low_52w\"]      = _l.rolling(252, min_periods=60).min()\n",
        "    df[\"pct_from_52h\"] = (close - df[\"high_52w\"]) / (df[\"high_52w\"] + 1e-9)\n",
        "    df[\"pct_from_52l\"] = (close - df[\"low_52w\"])  / (df[\"low_52w\"]  + 1e-9)\n",
        "\n",
        "    # ── 合併恆指特徵 ──────────────────────────────────────────\n",
        "    _hsi_want = [\n",
