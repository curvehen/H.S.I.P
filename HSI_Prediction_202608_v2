        "            df_slice = df_slice.between_time(\"09:30\", \"12:00\")\n",
        "        else:\n",
        "            df_slice = df_slice.between_time(\"09:30\", \"16:00\")\n",
        "\n",
        "        if df_slice.empty or len(df_slice) < 2:\n",
        "            continue\n",
        "\n",
        "        sim_time_str = bar_time.strftime(\"%H:%M\")\n",
        "\n",
        "        signal, score, reasons, price, vwap, rsi, \\\n",
        "        d_high, d_low, d_open, action, sl, tp = calc_signal(df_slice, hsi_daily, a_chg)\n",
        "\n",
        "        is_scheduled               = sim_time_str in SCHEDULED_AI_TIMES\n",
        "        is_sudden, sudden_reason, magnitude = detect_sudden_change(df_slice)\n",
        "        call_ai                    = is_scheduled or is_sudden\n",
        "\n",
        "        trigger_type = None\n",
        "        if is_sudden and is_scheduled:\n",
        "            trigger_type = \"定時+突變\"\n",
        "        elif is_sudden:\n",
        "            trigger_type = \"突變\"\n",
        "        elif is_scheduled:\n",
        "            trigger_type = \"定時\"\n",
        "\n",
        "        print(f\"\\n{'='*60}\")\n",
        "        if is_sudden:\n",
        "            print(f\"⚡ [{sim_time_str}] {session} ← 突變警報！{sudden_reason}\")\n",
        "        elif is_scheduled:\n",
        "            print(f\"⏰ [{sim_time_str}] {session} ← 定時分析\")\n",
        "        else:\n",
        "            print(f\"   [{sim_time_str}] {session}\")\n",
        "\n",
        "        print(f\"   信號: {signal} | 總分: {score}/6 | 現價: {price:.0f}\")\n",
        "\n",
        "        if action in [\"買入\", \"賣出\"]:\n",
        "            print(f\"   入場價: {price:.0f} | 止損: {sl:.0f} | 目標: {tp:.0f}\")\n",
        "\n",
        "        ai_result = None\n",
        "        if call_ai:\n",
        "            print(f\"   🤖 調用AI ({trigger_type})...\")\n",
        "            ai_result = ai_analysis(\n",
        "                signal, score, reasons, price, vwap, a_chg,\n",
        "                d_high, d_low, d_open, rsi, session,\n",
        "                sim_time_str, trigger_type, sudden_reason\n",
        "            )\n",
