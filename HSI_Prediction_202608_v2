      "source": [
        "# @title\n",
        "# ============================================================\n",
        "# Cell 7: 逐日模擬 (All Enhancements Applied)\n",
        "# ENH#1: Regime-based dynamic threshold\n",
        "# ENH#3: Kelly position sizing\n",
        "# ENH#4: Short signal multi-confirmation\n",
        "# ENH#5: Dynamic ensemble weighting\n",
        "# ENH#12: Walk-forward validation tracking\n",
        "# ✅ FIX: TRAIN_WINDOW 動態化，支援 ROLLING_YEARS 滾動訓練\n",
        "# ============================================================\n",
        "\n",
        "def do_retrain_fixed(train_df, reasons, fold_idx, feat_cols):\n",
        "    \"\"\"\n",
        "    執行重新訓練並決定是否採用新模型或回滾。\n",
        "    train_df : 用於重訓的歷史數據\n",
        "    reasons  : 觸發重訓的原因列表\n",
        "    fold_idx : 當前模型索引 (用於記錄)\n",
        "    feat_cols: 特徵欄位列表\n",
        "    \"\"\"\n",
        "    global global_model, regime_models, hmm\n",
        "\n",
        "    # ✅ FIX: 用動態 TRAIN_WINDOW 替換原有 hardcode 504\n",
        "    half_window = TRAIN_WINDOW // 2   # e.g. 5年=1260 → half=630\n",
        "\n",
        "    # ── 根據原因決定訓練窗口 ─────────────────────────────────────\n",
        "    if \"性能退化\" in reasons:\n",
        "        n      = len(train_df)\n",
        "        use_df = (train_df.iloc[-TRAIN_WINDOW:] if n >= TRAIN_WINDOW else\n",
        "                  train_df.iloc[-half_window:]  if n >= half_window  else\n",
        "                  train_df)\n",
        "        label  = \"近期窗口重訓\"\n",
        "\n",
        "    elif \"特徵漂移\" in reasons:\n",
        "        use_df = train_df\n",
        "        try:\n",
        "            hmm.fit(use_df)\n",
        "            use_df = hmm.add_features(use_df)\n",
        "        except Exception:\n",
        "            pass\n",
        "        label  = \"完整重訓\"\n",
        "\n",
        "    else:   # 定期更新\n",
        "        use_df = (train_df.iloc[-TRAIN_WINDOW:]\n",
        "                  if len(train_df) >= TRAIN_WINDOW else train_df)\n",
        "        label  = \"定期重訓\"\n",
        "\n",
        "    if len(use_df) < 120:\n",
        "        return \"數據不足，跳過\"\n",
        "\n",
        "    # ── 訓練新模型 ────────────────────────────────────────────────\n",
        "    new_model, new_auc = train_model_fixed(use_df, feat_cols)\n",
        "    if new_model is None:\n",
        "        return \"訓練條件不足，跳過\"\n",
        "\n",
        "    # ── 回滾判斷 ─────────────────────────────────────────────────\n",
        "    if memory.should_rollback(new_auc):\n",
        "        global_model = memory.get_best()[0]\n",
        "        action = (f\"{label}→回滾\"\n",
        "                  f\"(新={new_auc:.3f}\"\n",
        "                  f\"<最佳={memory.best_auc:.3f})\")\n",
        "    else:\n",
        "        global_model = new_model\n",
        "        memory.save(new_model, new_auc, {\n",
        "            \"fold\"   : fold_idx,\n",
        "            \"reasons\": reasons,\n",
        "            \"label\"  : label,\n",
        "        })\n",
        "        action = f\"{label}→採用(AUC={new_auc:.3f})\"\n",
        "\n",
        "    # ── 同步更新 Regime 模型 ──────────────────────────────────────\n",
        "    if \"hmm_regime\" in use_df.columns:\n",
        "        for regime in [\"bull\", \"bear\", \"neutral\"]:\n",
        "            rdf = use_df[use_df[\"hmm_regime\"] == regime]\n",
        "            if len(rdf) < 80:\n",
        "                continue\n",
        "            rm, r_auc = train_model_fixed(rdf, feat_cols)\n",
        "            if rm is not None:\n",
        "                regime_models[regime] = rm\n",
        "\n",
        "    return action\n",
        "\n",
        "\n",
        "# ── 確認依賴物件已初始化 (防止 NameError) ─────────────────────────\n",
        "assert global_model   is not None, \"global_model 未定義，請先執行 Cell 6\"\n",
        "assert isinstance(memory,  ModelMemory),  \"memory 未定義，請先執行 Cell 6\"\n",
        "assert isinstance(monitor, PerfMonitor),  \"monitor 未定義，請先執行 Cell 5/6\"\n",
        "assert isinstance(drift,   DriftDetector),\"drift 未定義，請先執行 Cell 5/6\"\n",
        "assert isinstance(hmm,     HMMRegime),    \"hmm 未定義，請先執行 Cell 5\"\n",
        "\n",
        "print(\"✅ do_retrain_fixed 已定義，開始模擬...\")\n",
        "print(\"=\" * 65)\n",
        "print(f\"  {TODAY.year} 逐日模擬 (ENH #1/#3/#4/#5/#12)\")\n",
        "print(f\"  TRAIN_WINDOW = {TRAIN_WINDOW} days ({ROLLING_YEARS} 年滾動)\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "sim_mask   = df_all[\"date\"] >= SIM_START\n",
        "df_sim     = df_all[sim_mask].copy().reset_index(drop=True)\n",
        "sim_records: list = []\n",
        "\n",
        "# ── 初始化狀態變數 ─────────────────────────────────────────────\n",
        "roll_acc           = 0.5\n",
        "roll_auc           = 0.5\n",
        "days_since_retrain = 0\n",
        "\n",
        "# ── ENH#12: Walk-Forward 追蹤器 ────────────────────────────────\n",
        "wf_monthly: dict = {}   # {YYYY-MM: {trades, correct, ret}}\n",
        "\n",
        "print(f\"\\n  模擬日數: {len(df_sim)}\")\n",
        "print(f\"\\n{'日期':>12} {'概率':>6} {'信號':>6} {'實際':>5} \"\n",
        "      f\"{'對錯':>4} {'命中率':>6} {'倉位':>6} \"\n",
        "      f\"{'重訓':>4} {'動作':>15}\")\n",
        "print(\"-\" * 80)\n",
        "\n",
        "for sim_idx in range(len(df_sim)):\n",
        "\n",
        "    sim_row  = df_sim.iloc[sim_idx]\n",
        "    sim_date = pd.Timestamp(sim_row[\"date\"])\n",
        "\n",
        "    # ── 用截至前一日真實數據 ───────────────────────────────────\n",
        "    known_mask = df_all[\"date\"] < sim_date\n",
        "    known_df   = df_all[known_mask].copy()\n",
        "\n",
        "    if len(known_df) == 0:\n",
        "        continue\n",
        "\n",
        "    if \"hmm_regime\" not in known_df.columns:\n",
        "        try:\n",
        "            known_df = hmm.add_features(known_df)\n",
        "        except Exception:\n",
        "            known_df[\"hmm_regime\"] = \"neutral\"\n",
        "\n",
        "    last_known = known_df.iloc[[-1]]\n",
        "\n",
        "    # ── 全局模型預測 ───────────────────────────────────────────\n",
        "    g_prob = safe_predict(global_model, last_known, feat_cols)\n",
        "\n",
        "    # ── Regime 識別 ────────────────────────────────────────────\n",
        "    regime = (str(last_known[\"hmm_regime\"].values[0])\n",
        "              if \"hmm_regime\" in last_known.columns\n",
        "              else \"neutral\")\n",
        "\n",
        "    # ── Regime 模型預測 ────────────────────────────────────────\n",
        "    r_prob = g_prob\n",
        "    if regime in regime_models:\n",
        "        r_prob = safe_predict(\n",
        "            regime_models[regime], last_known, feat_cols)\n",
        "\n",
        "    # ── ENH#5: 更新 ensemble weighter 歷史記錄 ─────────────────\n",
        "    if sim_idx > 0 and len(sim_records) > 0:\n",
        "        prev = sim_records[-1]\n",
        "        if \"actual_target\" in prev:\n",
        "            ensemble_weighter.update(\n",
        "                \"global\", prev[\"global_prob\"],\n",
        "                prev[\"actual_target\"])\n",
        "            ensemble_weighter.update(\n",
        "                \"regime\", prev[\"regime_prob\"],\n",
        "                prev[\"actual_target\"])\n",
        "\n",
        "    # ── ENH#5: 動態加權 Ensemble (替換原 0.5/0.5) ──────────────\n",
        "    ens_prob = ensemble_weighter.ensemble(g_prob, r_prob)\n",
        "\n",
        "    # ── ENH#1: Regime-based Threshold Calibration ──────────────\n",
        "    if sim_idx == 60 and len(sim_records) >= 30:\n",
        "        cal_df = pd.DataFrame(sim_records)\n",
        "        if all(c in cal_df.columns for c in\n",
        "               [\"regime\", \"ensemble_prob\", \"actual_target\"]):\n",
        "            threshold_calibrator.calibrate(\n",
        "                cal_df,\n",
        "                prob_col   = \"ensemble_prob\",\n",
        "                target_col = \"actual_target\",\n",
        "                regime_col = \"regime\",\n",
        "            )\n",
        "\n",
        "    if sim_idx > 60 and sim_idx % 42 == 0 and \\\n",
        "       len(sim_records) >= 60:\n",
        "        cal_df = pd.DataFrame(sim_records[-120:])\n",
        "        if all(c in cal_df.columns for c in\n",
        "               [\"regime\", \"ensemble_prob\", \"actual_target\"]):\n",
        "            threshold_calibrator.calibrate(\n",
        "                cal_df,\n",
        "                prob_col   = \"ensemble_prob\",\n",
        "                target_col = \"actual_target\",\n",
        "                regime_col = \"regime\",\n",
        "            )\n",
        "\n",
        "    # ── ENH#1: Regime-based signal generation ──────────────────\n",
        "    signal = threshold_calibrator.get_signal(ens_prob, regime)\n",
        "\n",
        "    # ── 市場方向過濾 ───────────────────────────────────────────\n",
        "    market_trend = get_market_trend(known_df, window=20)\n",
        "\n",
        "    if market_trend == \"bear\" and signal == 1 and ens_prob < 0.65:\n",
        "        signal = 0\n",
        "\n",
        "    # ── ENH#4: Short Signal Multi-Confirmation ─────────────────\n",
        "    short_confirm = {\"confirmed\": False, \"score\": 0, \"reasons\": []}\n",
        "    if signal == -1:\n",
        "        short_confirm = evaluate_short_confirmation(\n",
        "            last_known, regime, ens_prob)\n",
        "        if not short_confirm[\"confirmed\"]:\n",
        "            signal = 0\n",
        "        elif market_trend == \"bull\" and ens_prob > 0.35:\n",
        "            signal = 0\n",
        "\n",
        "    # ── 命中率保護 ─────────────────────────────────────────────\n",
        "    if sim_idx > 20 and roll_acc < 0.40:\n",
        "        signal = 0\n",
        "\n",
        "    # ── ENH#3: Kelly Position Sizing ──────────────────────────\n",
        "    position_size = position_sizer.compute_size(\n",
        "        prob     = ens_prob,\n",
        "        signal   = signal,\n",
        "        regime   = regime,\n",
        "        roll_acc = roll_acc if sim_idx > 5 else 0.5,\n",
        "    )\n",
        "\n",
        "    # ── 取得今日真實結果 ───────────────────────────────────────\n",
        "    actual_ret    = float(sim_row.get(\"next_ret\",   0))\n",
        "    actual_target = int(sim_row.get(\"target\",       0))\n",
        "\n",
        "    correct = None\n",
        "    if signal == 1:\n",
        "        correct = bool(actual_target == 1)\n",
        "    elif signal == -1:\n",
        "        correct = bool(actual_target == 0)\n",
        "\n",
        "    # ── ENH#3: 含倉位的策略回報 ───────────────────────────────\n",
        "    if signal != 0:\n",
        "        strat_ret  = position_size * signal * actual_ret\n",
        "        strat_ret -= TRANSACTION_COST * position_size\n",
        "    else:\n",
        "        strat_ret  = 0.0\n",
        "\n",
        "    # ── 更新性能監控 ───────────────────────────────────────────\n",
        "    monitor.update(ens_prob, actual_target)\n",
        "    roll_acc = monitor.rolling_accuracy()\n",
        "    roll_auc = monitor.rolling_auc()\n",
        "\n",
        "    # ── 偵測 Retrain 條件 ──────────────────────────────────────\n",
        "    perf_trigger,  perf_reason = monitor.should_retrain()\n",
        "    drift_trigger, drift_feats = drift.detect(\n",
        "        align_features(last_known, feat_cols)\n",
        "    )\n",
        "    days_since_retrain += 1\n",
        "\n",
        "    periodic = False\n",
        "    if days_since_retrain >= RETRAIN_INTERVAL:\n",
        "        if roll_acc >= 0.58:\n",
        "            days_since_retrain = 0\n",
        "        else:\n",
        "            periodic = True\n",
        "\n",
        "    reasons = []\n",
        "    if perf_trigger:  reasons.append(\"性能退化\")\n",
        "    if drift_trigger: reasons.append(\"特徵漂移\")\n",
        "    if periodic:      reasons.append(\"定期更新\")\n",
        "\n",
        "    do_rt  = bool(reasons)\n",
        "    action = \"—\"\n",
        "\n",
        "    # ── 執行 Retrain ───────────────────────────────────────────\n",
        "    if do_rt:\n",
        "        # ✅ FIX: retrain_df 同樣用 ROLLING_YEARS 窗口，唔取全部歷史\n",
        "        retrain_all = df_all[df_all[\"date\"] <= sim_date].copy()\n",
        "        retrain_df  = (retrain_all.iloc[-TRAIN_WINDOW:]\n",
        "                       if len(retrain_all) >= TRAIN_WINDOW\n",
        "                       else retrain_all)\n",
        "\n",
        "        if \"hmm_regime\" not in retrain_df.columns:\n",
        "            try:\n",
        "                retrain_df = hmm.add_features(retrain_df)\n",
        "            except Exception:\n",
        "                retrain_df[\"hmm_regime\"] = \"neutral\"\n",
        "\n",
        "        action = do_retrain_fixed(\n",
        "            retrain_df, reasons, sim_idx, feat_cols)\n",
        "\n",
        "        # ✅ FIX: drift ref 同樣用最近 ROLLING_YEARS 數據，非 hardcode 252\n",
        "        try:\n",
        "            drift.fit_ref(\n",
        "                align_features(\n",
        "                    retrain_df[feat_cols].iloc[-TRAIN_WINDOW:],\n",
        "                    feat_cols\n",
        "                )\n",
        "            )\n",
        "        except Exception:\n",
        "            pass\n",
        "\n",
        "        days_since_retrain = 0\n",
        "\n",
        "    # ── ENH#12: Walk-Forward 月度追蹤 ─────────────────────────\n",
        "    month_key = sim_date.strftime(\"%Y-%m\")\n",
        "    if month_key not in wf_monthly:\n",
        "        wf_monthly[month_key] = {\n",
        "            \"trades\" : 0,\n",
        "            \"correct\": 0,\n",
        "            \"ret\"    : 0.0,\n",
        "            \"long\"   : 0,\n",
        "            \"short\"  : 0,\n",
        "        }\n",
        "\n",
        "    if signal != 0:\n",
        "        wf_monthly[month_key][\"trades\"]  += 1\n",
        "        wf_monthly[month_key][\"ret\"]     += strat_ret\n",
        "        if signal == 1:\n",
        "            wf_monthly[month_key][\"long\"]  += 1\n",
        "        else:\n",
        "            wf_monthly[month_key][\"short\"] += 1\n",
        "        if correct:\n",
        "            wf_monthly[month_key][\"correct\"] += 1\n",
        "\n",
        "    # ── 記錄到 sim_records ─────────────────────────────────────\n",
        "    sig_str = (\"▲Long\"  if signal ==  1 else\n",
        "               \"▼Short\" if signal == -1 else \"Hold\")\n",
        "    act_str = \"Up\"  if actual_target == 1 else \"Dn\"\n",
        "    cor_str = (\"✓\" if correct is True  else\n",
        "               \"✗\" if correct is False else \"—\")\n",
        "    rt_str  = f\"{position_size:.0%}\" if signal != 0 else \"—\"\n",
        "\n",
        "    sim_records.append({\n",
        "        \"date\"               : sim_date,\n",
        "        \"close\"              : float(sim_row.get(\"close\", 0)),\n",
        "        \"regime\"             : regime,\n",
        "        \"global_prob\"        : round(g_prob,          4),\n",
        "        \"regime_prob\"        : round(r_prob,          4),\n",
        "        \"ensemble_prob\"      : round(ens_prob,        4),\n",
        "        \"signal\"             : signal,\n",
        "        \"position_size\"      : round(position_size,   4),\n",
        "        \"actual_ret\"         : actual_ret,\n",
        "        \"strat_ret\"          : round(strat_ret,       6),\n",
        "        \"actual_target\"      : actual_target,\n",
        "        \"correct\"            : correct,\n",
        "        \"retrain\"            : do_rt,\n",
        "        \"retrain_reason\"     : \",\".join(reasons),\n",
        "        \"action\"             : action,\n",
        "        \"roll_acc\"           : round(roll_acc,        4),\n",
        "        \"roll_auc\"           : round(roll_auc,        4),\n",
        "        \"best_model_auc\"     : round(memory.best_auc, 4),\n",
        "        \"short_confirm_score\": short_confirm[\"score\"],\n",
        "        \"ens_weight_summary\" : ensemble_weighter.weight_summary(),\n",
        "        \"market_trend\"       : market_trend,\n",
        "    })\n",
        "\n",
        "    print(f\"  {str(sim_date.date()):>12} \"\n",
