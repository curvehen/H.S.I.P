        "        df_all[feat_cols].iloc[-21:]\n",
        "    )\n",
        "\n",
        "    retrain_reasons = []\n",
        "    if perf_trigger:  retrain_reasons.append(\"性能退化\")\n",
        "    if drift_trigger: retrain_reasons.append(\"特徵漂移\")\n",
        "\n",
        "    if retrain_reasons:\n",
        "        print(f\"  ⚠️  觸發 Retrain: {', '.join(retrain_reasons)}\")\n",
        "        if drift_trigger:\n",
        "            print(f\"     漂移特徵: {drift_feats[:3]}\")\n",
        "\n",
        "        # 決定訓練數據\n",
        "        if \"性能退化\" in retrain_reasons:\n",
        "            retrain_df = df_all.iloc[-TRAIN_WINDOW//2:]\n",
        "        else:\n",
        "            retrain_df = df_all.iloc[-TRAIN_WINDOW:]\n",
        "\n",
        "        if \"特徵漂移\" in retrain_reasons:\n",
        "            hmm.fit(retrain_df)\n",
        "            retrain_df = hmm.add_features(retrain_df)\n",
        "\n",
        "        vc    = int(len(retrain_df) * 0.85)\n",
        "        X_tr  = retrain_df[feat_cols].iloc[:vc]\n",
        "        y_tr  = retrain_df[\"target\"].iloc[:vc]\n",
        "        X_val = retrain_df[feat_cols].iloc[vc:]\n",
        "        y_val = retrain_df[\"target\"].iloc[vc:]\n",
        "\n",
        "        if (len(y_tr.unique()) > 1 and\n",
        "            len(y_val.unique()) > 1 and\n",
        "            len(y_tr) >= 60):\n",
        "            try:\n",
        "                new_m   = train_lgbm(X_tr, y_tr, X_val, y_val)\n",
        "                new_auc = eval_model(new_m, X_val, y_val)[\"auc\"]\n",
        "\n",
        "                if memory.should_rollback(new_auc):\n",
        "                    global_model = memory.get_best()[0]\n",
        "                    print(f\"  → 新模型AUC={new_auc:.4f} < \"\n",
        "                          f\"最佳{memory.best_auc:.4f}，回滾\")\n",
        "                else:\n",
        "                    global_model = new_m\n",
        "                    memory.save(new_m, new_auc,\n",
        "                                {\"reason\": retrain_reasons})\n",
        "                    print(f\"  ✅ Retrain 完成 (AUC={new_auc:.4f})\")\n",
        "\n",
        "                # 更新 Regime 模型\n",
        "                for regime in [\"bull\",\"bear\",\"neutral\"]:\n",
        "                    rdf = retrain_df[\n",
        "                        retrain_df.get(\"hmm_regime\",\n",
        "                                       pd.Series()) == regime\n",
        "                    ] if \"hmm_regime\" in retrain_df.columns \\\n",
        "                      else pd.DataFrame()\n",
        "                    if len(rdf) < 80:\n",
        "                        continue\n",
        "                    vc_r   = int(len(rdf)*0.85)\n",
        "                    Xr_tr  = rdf[feat_cols].iloc[:vc_r]\n",
        "                    yr_tr  = rdf[\"target\"].iloc[:vc_r]\n",
        "                    Xr_val = rdf[feat_cols].iloc[vc_r:]\n",
        "                    yr_val = rdf[\"target\"].iloc[vc_r:]\n",
        "                    if (len(yr_tr.unique()) < 2 or\n",
