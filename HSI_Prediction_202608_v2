        "\n",
        "    if \"open\" in df.columns:\n",
        "        df[\"gap_ret\"] = (\n",
        "            df[\"open\"] - close.shift(1)\n",
        "        ) / (close.shift(1) + 1e-9)\n",
        "\n",
        "    for w in [5, 10, 20, 60]:\n",
        "        ma = close.rolling(w, min_periods=w // 2).mean()\n",
        "        df[f\"ma_dev_{w}\"] = (close - ma) / (ma + 1e-9)\n",
        "\n",
        "    df[\"ma5_20\"] = (\n",
        "        close.rolling(5,  min_periods=3).mean() >\n",
        "        close.rolling(20, min_periods=10).mean()\n",
        "    ).astype(int)\n",
        "    df[\"ma20_60\"] = (\n",
        "        close.rolling(20, min_periods=10).mean() >\n",
        "        close.rolling(60, min_periods=30).mean()\n",
        "    ).astype(int)\n",
        "\n",
        "    if {\"open\", \"high\", \"low\"}.issubset(df.columns):\n",
        "        body  = (df[\"open\"] - close).abs()\n",
        "        upper = df[\"high\"] - df[[\"open\", \"close\"]].max(axis=1)\n",
        "        lower = df[[\"open\", \"close\"]].min(axis=1) - df[\"low\"]\n",
        "        df[\"upper_wick\"] = upper / (body + 1e-9)\n",
        "        df[\"lower_wick\"] = lower / (body + 1e-9)\n",
        "        df[\"body_size\"]  = body  / (close + 1e-9)\n",
        "\n",
        "    # ── 成交量特徵（多 seed ensemble 穩定版）─────────────────\n",
        "    if \"volume\" in df.columns:\n",
        "        vol = df[\"volume\"]\n",
        "        for w in [5, 10, 20]:\n",
        "            df[f\"vol_surge_{w}\"] = _vol_surge_ensemble(vol, w)\n",
        "        df[\"vol_trend\"] = (\n",
        "            vol.rolling(5,  min_periods=3).mean() /\n",
        "            (vol.rolling(20, min_periods=10).mean() + 1e-9)\n",
        "        )\n",
        "        # ✅ 額外：成交量動能（替代主力資金流信號）\n",
        "        df[\"vol_momentum\"]   = vol.pct_change(5)\n",
        "        df[\"vol_price_corr\"] = (\n",
        "            vol.rolling(10, min_periods=5)\n",
        "            .corr(close.pct_change().abs())\n",
        "        )\n",
        "\n",
        "    # ── 技術指標 ──────────────────────────────────────────────\n",
        "    df[\"rsi_6\"]       = RSIIndicator(close, window=6).rsi()\n",
        "    df[\"rsi_14\"]      = RSIIndicator(close, window=14).rsi()\n",
        "    # RSI 動能（超買/超賣變化速度）\n",
        "    df[\"rsi_slope\"]   = df[\"rsi_14\"].diff(3)\n",
        "\n",
        "    macd_obj          = MACD(close)\n",
        "    df[\"macd\"]        = macd_obj.macd()\n",
        "    df[\"macd_signal\"] = macd_obj.macd_signal()\n",
        "    df[\"macd_diff\"]   = macd_obj.macd_diff()\n",
        "    # MACD 方向變化\n",
        "    df[\"macd_cross\"]  = (\n",
        "        (df[\"macd_diff\"] > 0) & (df[\"macd_diff\"].shift(1) <= 0)\n",
        "    ).astype(int) - (\n",
        "        (df[\"macd_diff\"] < 0) & (df[\"macd_diff\"].shift(1) >= 0)\n",
        "    ).astype(int)\n",
        "\n",
        "    bb = BollingerBands(close, window=20)\n",
        "    df[\"bb_pos\"]   = (\n",
        "        (close - bb.bollinger_lband()) /\n",
        "        (bb.bollinger_hband() - bb.bollinger_lband() + 1e-9)\n",
        "    )\n",
        "    df[\"bb_width\"] = (\n",
        "        bb.bollinger_hband() - bb.bollinger_lband()\n",
        "    ) / (close + 1e-9)\n",
        "\n",
        "    if {\"high\", \"low\"}.issubset(df.columns):\n",
        "        atr             = AverageTrueRange(\n",
        "            df[\"high\"], df[\"low\"], close, window=14\n",
        "        )\n",
        "        df[\"atr_14\"]    = atr.average_true_range()\n",
        "        df[\"atr_ratio\"] = df[\"atr_14\"] / (close + 1e-9)\n",
        "\n",
        "    # ── 波動率 Regime ──────────────────────────────────────────\n",
        "    ret             = close.pct_change()\n",
        "    df[\"vol_20\"]    = ret.rolling(20, min_periods=10).std()\n",
        "    df[\"vol_60\"]    = ret.rolling(60, min_periods=30).std()\n",
        "    df[\"vol_ratio\"] = df[\"vol_20\"] / (df[\"vol_60\"] + 1e-9)\n",
        "    df[\"high_vol\"]  = (df[\"vol_20\"] > df[\"vol_60\"]).astype(int)\n",
        "    df[\"trend_up\"]  = (\n",
