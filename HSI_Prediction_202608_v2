        "\n",
        "print(\"\\n  計算個股高低位估算 (ATR-based)...\")\n",
        "\n",
        "for idx, row in pred_df.iterrows():\n",
        "    ticker = row[\"ticker\"]\n",
        "    close  = float(row[\"close\"]) if row[\"close\"] else 0.0\n",
        "\n",
        "    if close <= 0:\n",
        "        pred_df.at[idx, \"pred_high\"]  = None\n",
        "        pred_df.at[idx, \"pred_low\"]   = None\n",
        "        pred_df.at[idx, \"pred_close\"] = None\n",
        "        continue\n",
        "\n",
        "    # ── 取 ATR: 優先 stock_feat_data ─────────────────────────\n",
        "    atr_val = None\n",
        "    try:\n",
        "        df_stk = stock_feat_data.get(ticker)\n",
        "        if df_stk is not None:\n",
        "            for col in [\"atr_ratio\", \"vol_20\", \"vol_5d\"]:\n",
        "                if col in df_stk.columns:\n",
        "                    v = df_stk[col].dropna()\n",
        "                    if len(v) > 0:\n",
        "                        raw = float(v.iloc[-1])\n",
        "                        if col == \"atr_14\":\n",
        "                            atr_val = raw / close\n",
        "                        else:\n",
        "                            atr_val = raw\n",
        "                        if atr_val and atr_val > 0:\n",
        "                            break\n",
        "    except Exception:\n",
        "        pass\n",
        "\n",
        "    # ── Fallback: pred_df 的 vol_20 ──────────────────────────\n",
        "    if atr_val is None or atr_val <= 0:\n",
