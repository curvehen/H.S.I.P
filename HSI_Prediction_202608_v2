        "\n",
        "        if MORNING_START <= t <= MORNING_END:\n",
        "            session = \"早市\" if t < time(12, 0) else \"午休\"\n",
        "        else:\n",
        "            session = \"下午\"\n",
        "\n",
        "        df_slice = hsi_today[hsi_today.index <= bar_time]\n",
