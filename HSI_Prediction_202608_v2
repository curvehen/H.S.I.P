        "# @title\n",
        "# ============================================================\n",
        "# Cell 29B: 每日股票更新（完整修正版）\n",
        "# 修正：\n",
        "#   1. build_stock_features 加 ticker 參數\n",
        "#   2. _parse_val_acc 統一解析 val_acc\n",
        "#   3. pkg.get(\"feat_cols\") 防 KeyError\n",
        "#   4. last = known.iloc[[-1]].copy() 防 SettingWithCopyWarning\n",
        "#   5. 即時訓練補 val_acc\n",
        "#   6. 空 quick_preds guard\n",
        "#   7. 全局字典 runtime reset 後自動恢復\n",
        "# ============================================================\n",
        "from datetime import datetime\n",
        "import time, os\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import joblib\n",
        "import yfinance as yf\n",
        "\n",
        "# ── _parse_val_acc（若 Cell 26 未執行則補定義）──────────────\n",
        "if \"_parse_val_acc\" not in dir():\n",
        "    def _parse_val_acc(v):\n",
        "        \"\"\"兼容 float / dict / None / NaN → 返回 float 或 None\"\"\"\n",
        "        try:\n",
        "            if v is None: return None\n",
        "            if isinstance(v, dict): v = v.get(\"val_acc\")\n",
        "            if v is None: return None\n",
        "            v = float(v)\n",
        "            return None if (v != v) else v\n",
        "        except Exception:\n",
        "            return None\n",
        "\n",
        "# ── 安全格式化 ───────────────────────────────────────────────\n",
        "def _fs(val, fmt):\n",
        "    try:\n",
        "        if val is None: return \"N/A\"\n",
        "        f = float(val)\n",
        "        if f != f: return \"N/A\"\n",
        "        return format(f, fmt)\n",
        "    except Exception:\n",
        "        return \"N/A\"\n",
        "\n",
        "# ============================================================\n",
        "def daily_stock_update():\n",
        "    global stock_data, stock_feat_data, stock_models, \\\n",
        "           stock_feat_cols_per, stock_train_scores\n",
        "\n",
        "    # ── 確保全局字典存在 ─────────────────────────────────────\n",
        "    if \"stock_models\"        not in globals(): stock_models        = {}\n",
        "    if \"stock_feat_cols_per\" not in globals(): stock_feat_cols_per = {}\n",
        "    if \"stock_train_scores\"  not in globals(): stock_train_scores  = {}\n",
        "\n",
        "    CTX              = get_prediction_context()\n",
        "    PREDICT_DATE_STR = CTX[\"predict_date_str\"]\n",
        "    BASE_DATE_STR    = CTX[\"base_date_str\"]\n",
        "\n",
        "    print(\"=\" * 60)\n",
        "    print(\"  🔄 每日股票數據更新\")\n",
        "    print(f\"  香港時間 : {CTX['now_hkt_str']}\")\n",
        "    print(f\"  預測目標 : {PREDICT_DATE_STR}\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    updated, failed = 0, []\n",
        "\n",
        "    # ── [1/3] 下載最新數據 ─────────────────────────────────\n",
        "    print(\"\\n[1/3] 下載最新股票數據...\")\n",
        "    for ticker, name in STOCK_LIST.items():\n",
        "        try:\n",
        "            tkr    = yf.Ticker(ticker)\n",
        "            df_new = tkr.history(period=\"5d\", auto_adjust=True)\n",
        "            if df_new is None or len(df_new) == 0:\n",
        "                continue\n",
        "\n",
        "            df_new = df_new.reset_index()\n",
        "            dc     = next(\n",
        "                c for c in df_new.columns\n",
        "                if \"date\" in str(c).lower()\n",
        "            )\n",
        "            df_new[dc] = (\n",
        "                pd.to_datetime(df_new[dc]).dt.tz_localize(None)\n",
        "            )\n",
        "            df_new = df_new.rename(columns={dc: \"date\"})\n",
        "            df_new.columns = [c.lower() for c in df_new.columns]\n",
        "\n",
        "            existing = stock_data.get(ticker)\n",
        "            if existing is not None:\n",
        "                last_date = existing[\"date\"].max()\n",
        "                new_rows  = df_new[\n",
        "                    df_new[\"date\"] > last_date\n",
        "                ].copy()\n",
        "                if len(new_rows) > 0:\n",
        "                    new_rows[\"ticker\"] = ticker\n",
        "                    new_rows[\"name\"]   = name\n",
        "                    new_rows[\"sector\"] = SECTOR_MAP.get(ticker, \"其他\")\n",
        "                    stock_data[ticker] = (\n",
        "                        pd.concat([existing, new_rows])\n",
        "                        .drop_duplicates(subset=[\"date\"])\n",
        "                        .sort_values(\"date\")\n",
        "                        .reset_index(drop=True)\n",
        "                    )\n",
        "                    updated += 1\n",
        "            time.sleep(0.2)\n",
        "\n",
        "        except Exception as e:\n",
        "            failed.append(f\"{name}: {str(e)[:40]}\")\n",
        "\n",
        "    print(f\"  ✅ 更新 {updated} 隻股票\")\n",
        "    if failed:\n",
        "        print(f\"  ⚠️  失敗: {failed[:3]}\")\n",
        "\n",
        "    # ── [2/3] 重新建立特徵 ─────────────────────────────────\n",
        "    # ✅ 修正：加入 ticker 參數（資金流特徵需要）\n",
        "    print(\"\\n[2/3] 更新特徵（含資金流）...\")\n",
        "    feat_ok, feat_err = 0, []\n",
        "    for ticker in list(stock_data.keys()):\n",
        "        name = STOCK_LIST.get(ticker, ticker)\n",
        "        try:\n",
        "            stock_feat_data[ticker] = build_stock_features(\n",
        "                stock_data[ticker], df_all, ticker=ticker   # ← ticker 參數\n",
        "            )\n",
        "            feat_ok += 1\n",
        "        except Exception as fe:\n",
        "            feat_err.append(f\"{name}: {str(fe)[:40]}\")\n",
        "\n",
        "    print(f\"  ✅ {feat_ok} 隻股票特徵已更新\")\n",
        "    if feat_err:\n",
        "        print(f\"  ⚠️  特徵失敗: {feat_err[:3]}\")\n",
        "\n",
        "    # ── [3/3] 生成預測 ─────────────────────────────────────\n",
        "    print(\"\\n[3/3] 生成預測...\")\n",
        "    quick_preds = []\n",
        "\n",
        "    for ticker, name in STOCK_LIST.items():\n",
        "        hist = stock_feat_data.get(ticker)\n",
        "        if hist is None or len(hist) < 20:\n",
        "            continue\n",
        "\n",
        "        model     = stock_models.get(ticker)\n",
        "        feat_cols = stock_feat_cols_per.get(ticker)\n",
        "\n",
        "        # ── 記憶體冇有，從 pkl 載入 ───────────────────────\n",
        "        if model is None or feat_cols is None:\n",
        "            pkl_path = (\n",
        "                f\"models/stocks/\"\n",
        "                f\"{ticker.replace('.','_')}.pkl\"\n",
        "            )\n",
        "            if os.path.exists(pkl_path):\n",
        "                try:\n",
        "                    pkg       = joblib.load(pkl_path)\n",
        "                    model     = pkg[\"model\"]\n",
        "                    # ✅ .get() 防 KeyError\n",
        "                    feat_cols = pkg.get(\n",
        "                        \"feat_cols\",\n",
        "                        list(stock_feat_cols_per.values())[0]\n",
        "                        if stock_feat_cols_per else []\n",
        "                    )\n",
        "                    stock_models[ticker]        = model\n",
        "                    stock_feat_cols_per[ticker] = feat_cols\n",
        "                    # 同步恢復 val_acc\n",
        "                    if ticker not in stock_train_scores:\n",
        "                        stock_train_scores[ticker] = _parse_val_acc(\n",
        "                            pkg.get(\"val_acc\")\n",
        "                        )\n",
        "                except Exception as load_e:\n",
        "                    print(f\"  ❌ {name} pkl 載入失敗: {load_e}\")\n",
        "                    model, feat_cols = None, None\n",
        "\n",
        "            # ── pkl 不存在 → 即時訓練 ─────────────────────\n",
        "            if model is None:\n",
        "                print(f\"  ⚙️  {name}: 即時訓練模型...\")\n",
        "                try:\n",
        "                    _df      = hist.copy()\n",
        "                    _exclude = {\n",
        "                        \"date\", \"ticker\", \"name\", \"sector\",\n",
        "                        \"next_ret\", \"target\", \"high_52w\", \"low_52w\"\n",
        "                    }\n",
        "                    feat_cols = [\n",
        "                        c for c in _df.columns\n",
        "                        if c not in _exclude\n",
        "                        and _df[c].dtype in [\n",
        "                            np.float64, np.float32,\n",
        "                            np.int64,   np.int32,\n",
        "                            float, int\n",
        "                        ]\n",
        "                    ]\n",
        "                    _clean = (\n",
        "                        _df.dropna(subset=feat_cols + [\"target\"])\n",
        "                        .reset_index(drop=True)\n",
        "                    )\n",
        "                    if len(_clean) < 100:\n",
        "                        print(f\"  ⚠️  {name}: 樣本不足，跳過\")\n",
        "                        continue\n",
        "\n",
        "                    import lightgbm as lgb\n",
        "                    from sklearn.calibration import CalibratedClassifierCV\n",
        "\n",
        "                    _X  = _clean[feat_cols].values.astype(np.float32)\n",
        "                    _y  = _clean[\"target\"].values.astype(int)\n",
        "                    _sp = int(len(_X) * 0.8)\n",
        "\n",
        "                    _m = lgb.LGBMClassifier(\n",
        "                        n_estimators  = 200,\n",
        "                        learning_rate = 0.05,\n",
        "                        num_leaves    = 31,\n",
        "                        verbose       = -1,\n",
        "                        random_state  = 42,\n",
        "                    )\n",
        "                    _m.fit(_X[:_sp], _y[:_sp])\n",
        "                    _cal = CalibratedClassifierCV(\n",
        "                        _m, cv=\"prefit\", method=\"isotonic\"\n",
        "                    )\n",
        "                    _cal.fit(_X[_sp:], _y[_sp:])\n",
        "\n",
        "                    # ✅ 即時訓練 val_acc（存 float）\n",
        "                    _va = float(\n",
        "                        (_cal.predict(_X[_sp:]) == _y[_sp:]).mean()\n",
        "                    )\n",
        "                    model     = _cal\n",
        "                    stock_models[ticker]        = model\n",
        "                    stock_feat_cols_per[ticker] = feat_cols\n",
        "                    stock_train_scores[ticker]  = round(_va, 4)\n",
        "\n",
        "                except Exception as train_e:\n",
        "                    print(f\"  ❌ {name} 即時訓練失敗: {train_e}\")\n",
        "                    continue\n",
        "\n",
        "        # ── 取最後一行（✅ .copy() 防 SettingWithCopyWarning）\n",
        "        known = hist[\n",
        "            hist[\"date\"] <= pd.Timestamp(BASE_DATE_STR)\n",
        "        ]\n",
        "        if len(known) < 20:\n",
        "            continue\n",
        "\n",
        "        last = known.iloc[[-1]].copy()   # ← .copy()\n",
        "\n",
        "        # ── 對齊特徵 ─────────────────────────────────────\n",
        "        try:\n",
        "            missing = [c for c in feat_cols if c not in last.columns]\n",
        "            for mc in missing:\n",
        "                last[mc] = 0.0\n",
        "            X    = last[feat_cols].fillna(0).values\n",
        "            prob = float(model.predict_proba(X)[:, 1][0])\n",
        "        except Exception as pred_e:\n",
        "            print(f\"  ⚠️  {name} 預測失敗: {pred_e}\")\n",
        "            continue\n",
        "\n",
        "        prob   = float(np.clip(prob, 0, 1))\n",
        "        signal = (\n",
        "             1 if prob >= PROB_LONG\n",
        "            else -1 if prob <= PROB_SHORT\n",
        "            else 0\n",
        "        )\n",
        "\n",
        "        # ✅ val_acc 統一用 _parse_val_acc → 永遠係 float/None\n",
        "        val_acc = _parse_val_acc(stock_train_scores.get(ticker))\n",
        "\n",
        "        # ── 預測 High / Low / Close ───────────────────────\n",
        "        last_close     = float(known[\"close\"].iloc[-1]) \\\n",
        "                         if \"close\" in known.columns else None\n",
        "        pred_high_abs  = None\n",
        "        pred_low_abs   = None\n",
        "        pred_close_abs = None\n",
        "\n",
        "        if last_close:\n",
        "            try:\n",
        "                atr_ratio = (\n",
        "                    float(last[\"atr_ratio\"].fillna(0.015).values[0])\n",
        "                    if \"atr_ratio\" in last.columns else 0.015\n",
        "                )\n",
        "                exp_ret        = (prob - 0.5) * 2 * atr_ratio\n",
        "                half_range     = atr_ratio * 1.2\n",
        "                pred_close_abs = round(last_close * (1 + exp_ret),             2)\n",
        "                pred_high_abs  = round(last_close * (1 + exp_ret + half_range), 2)\n",
        "                pred_low_abs   = round(last_close * (1 + exp_ret - half_range), 2)\n",
        "            except Exception:\n",
        "                pass\n",
        "\n",
        "        # ── 資金流信號摘要 ────────────────────────────────\n",
        "        flow_signal = None\n",
        "        try:\n",
        "            if \"main_net_z20\" in last.columns:\n",
        "                mz = float(last[\"main_net_z20\"].fillna(0).values[0])\n",
        "                sr = float(last[\"smart_vs_retail\"].fillna(0).values[0])\n",
        "                fs = float(last[\"flow_streak3\"].fillna(0).values[0])\n",
        "                if mz > 1.0 and sr >= 0 and fs >= 0:\n",
        "                    flow_signal = \"主力流入\"\n",
        "                elif mz < -1.0 and sr <= 0 and fs <= 0:\n",
