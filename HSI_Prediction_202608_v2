        "df_bt[\"sig_change\"]   = df_bt[\"signal\"].diff().abs().fillna(0)\n",
        "df_bt[\"cost\"]         = df_bt[\"sig_change\"] * TRANSACTION_COST\n",
        "df_bt[\"strategy_ret\"] = df_bt[\"signal\"] * df_bt[\"actual_ret\"] - df_bt[\"cost\"]\n",
        "df_bt[\"gross_ret\"]    = df_bt[\"signal\"] * df_bt[\"actual_ret\"]\n",
        "df_bt[\"bh_ret\"]       = df_bt[\"actual_ret\"]\n",
        "\n",
        "# ── 累積回報 ─────────────────────────────────────────────────\n",
        "df_bt[\"cum_strategy\"] = (1 + df_bt[\"strategy_ret\"]).cumprod()\n",
        "df_bt[\"cum_gross\"]    = (1 + df_bt[\"gross_ret\"]).cumprod()\n",
        "df_bt[\"cum_bh\"]       = (1 + df_bt[\"bh_ret\"]).cumprod()\n",
        "\n",
        "# ── 滾動指標 ─────────────────────────────────────────────────\n",
        "df_bt[\"roll_sharpe\"] = (\n",
        "    df_bt[\"strategy_ret\"]\n",
        "    .rolling(42)\n",
        "    .apply(lambda x: x.mean()/x.std()*np.sqrt(252)\n",
        "           if x.std() > 0 else 0)\n",
        ")\n",
        "\n",
        "# ── 績效函數 ─────────────────────────────────────────────────\n",
        "def sharpe(r):\n",
        "    return r.mean()/r.std()*np.sqrt(252) if r.std()>0 else 0\n",
        "\n",
        "def max_dd(cum):\n",
        "    return ((cum - cum.cummax()) / cum.cummax()).min()\n",
        "\n",
        "def calmar(r, cum):\n",
        "    ann = r.mean() * 252\n",
        "    mdd = abs(max_dd(cum))\n",
        "    return ann/mdd if mdd>0 else 0\n",
        "\n",
        "def win_rate(r):\n",
        "    pos = r[r!=0]\n",
        "    return (pos>0).sum()/len(pos) if len(pos)>0 else 0\n",
