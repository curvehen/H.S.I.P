        "\n",
        "\n",
        "def is_weekday(dt):\n",
        "    \"\"\"係咪平日（週一至週五）\"\"\"\n",
        "    return dt.weekday() < 5\n",
        "\n",
        "\n",
        "def is_market_hours(dt):\n",
        "    \"\"\"\n",
        "    係咪交易時間內\n",
        "    港股：09:30 - 16:00 HKT\n",
