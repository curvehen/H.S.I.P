        "    )\n",
        "\n",
        "    print(f\"\\n  總預測次數: {len(log_df)}\")\n",
        "    print(f\"  首次預測  : {log_df['run_time'].min().date()}\")\n",
        "    print(f\"  最後預測  : {log_df['run_time'].max().date()}\")\n",
        "    print()\n",
        "\n",
        "    # ── 打印最近10次預測記錄 ─────────────────────────────────\n",
        "    print(f\"  {'日期':>12} {'Regime':>8} {'P(升)':>7} \"\n",
        "          f\"{'信號':>8} {'強度':>6} {'滾動命中':>8}\")\n",
        "    print(\"  \" + \"-\" * 58)\n",
        "\n",
        "    for _, row in log_df.tail(10).iterrows():\n",
        "        regime_s  = str(row.get(\"regime\",   \"—\"))\n",
        "        signal_s  = str(row.get(\"signal_str\",\"—\"))\n",
        "        strength_s= str(row.get(\"strength\", \"—\"))\n",
        "        roll_acc  = row.get(\"roll_acc\", 0)\n",
        "\n",
        "        print(f\"  {str(row['base_date']):>12} \"\n",
        "              f\"{regime_s:>8} \"\n",
        "              f\"{row['ensemble_prob']:>7.3f} \"\n",
        "              f\"{signal_s:>8} \"\n",
        "              f\"{strength_s:>6} \"\n",
        "              f\"{roll_acc:>8.2%}\")\n",
        "\n",
        "else:\n",
        "    print(\"\\n  ℹ️  暫無預測記錄\")\n",
        "    print(\"  → 請先執行 Cell 13（每日更新）\")\n",
        "\n",
        "# ── 預測 vs 實際對比 ─────────────────────────────────────────\n",
        "print()\n",
        "print(\"=\" * 60)\n",
        "print(\"  📊 預測 vs 實際對比（最近20日）\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "try:\n",
        "    if len(sim_df) > 0:\n",
        "        print(f\"\\n  {'日期':>12} {'P(升)':>7} {'信號':>6} \"\n",
        "              f\"{'實際':>6} {'正確':>5} {'回報':>8} {'Regime':>8}\")\n",
        "        print(\"  \" + \"-\" * 65)\n",
        "\n",
        "        recent = sim_df.tail(20)\n",
        "        for _, row in recent.iterrows():\n",
        "            sig_s = (\"▲\" if row[\"signal\"] ==  1\n",
        "                     else \"▼\" if row[\"signal\"] == -1\n",
        "                     else \"—\")\n",
        "            act_s = \"升\" if row[\"actual_target\"] == 1 else \"跌\"\n",
