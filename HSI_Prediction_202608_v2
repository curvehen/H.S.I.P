        "# @title\n",
        "# ============================================================\n",
        "# DASHSCOPE_API_KEY = \"sk-ws-H.DMPMLMP.lYmc.MEUCIQC13gDD5jWWo1qA2t_f1j1C9uDCjqbN6ppUinCHLXnmjgIgCH5S1zPqysnbRuPjkQHBFlZbOUL-jUhBhKz4ow6bB1Q\" #userdata.get('DASHSCOPE_API_KEY')\n",
        "# HSI 預測系統 v5.2 - Backtest模式\n",
        "# AI調用規則：\n",
        "#   - 定時：09:30, 10:30, 11:30, 12:30, 13:30, 14:30\n",
        "#   - 突變：每15分鐘檢查，若價格突變超過閾值，立即調用AI\n",
        "# ============================================================\n",
        "\n",
        "# ============================================================\n",
        "# HSI 預測系統 v5.3 - 實時監控模式\n",
        "# ============================================================\n",
        "\n",
        "!pip install yfinance openai pandas numpy pytz -q\n",
        "\n",
        "import yfinance as yf\n",
        "from openai import OpenAI\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from datetime import datetime, time, timedelta\n",
        "import pytz\n",
        "import time as time_module\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# ============================================================\n",
        "# 設定\n",
        "# ============================================================\n",
        "HK_TZ = pytz.timezone(\"Asia/Hong_Kong\")\n",
        "\n",
        "DASHSCOPE_API_KEY = \"sk-ws-H.DMPMLMP.lYmc.MEUCIQC13gDD5jWWo1qA2t_f1j1C9uDCjqbN6ppUinCHLXnmjgIgCH5S1zPqysnbRuPjkQHBFlZbOUL-jUhBhKz4ow6bB1Q\"\n",
        "\n",
        "ai_client = OpenAI(\n",
        "    api_key=DASHSCOPE_API_KEY,\n",
        "    base_url=\"https://dashscope-intl.aliyuncs.com/compatible-mode/v1\"\n",
        ")\n",
        "AI_MODEL = \"qwen-plus\"\n",
        "\n",
        "# ============================================================\n",
        "# 突變閾值設定\n",
        "# ============================================================\n",
        "SUDDEN_CHANGE_THRESHOLD = 0.3\n",
        "SUDDEN_RANGE_THRESHOLD  = 0.4\n",
        "SCHEDULED_AI_TIMES      = [\"11:30\", \"12:30\", \"13:30\"]\n",
        "\n",
        "# ============================================================\n",
        "# 數據下載（Backtest用）\n",
        "# ============================================================\n",
        "def download_full_data(date_str=None):\n",
        "    print(f\"📥 下載數據中...\")\n",
        "\n",
        "    hsi = yf.download(\"^HSI\", period=\"5d\", interval=\"15m\", progress=False)\n",
        "    hsi.index = hsi.index.tz_convert(HK_TZ)\n",
        "    if isinstance(hsi.columns, pd.MultiIndex):\n",
        "        hsi.columns = hsi.columns.droplevel(1)\n",
        "\n",
        "    ss = yf.download(\"000001.SS\", period=\"5d\", interval=\"1d\", progress=False)\n",
        "    if isinstance(ss.columns, pd.MultiIndex):\n",
        "        ss.columns = ss.columns.droplevel(1)\n",
        "\n",
        "    hsi_daily = yf.download(\"^HSI\", period=\"30d\", interval=\"1d\", progress=False)\n",
        "    if isinstance(hsi_daily.columns, pd.MultiIndex):\n",
        "        hsi_daily.columns = hsi_daily.columns.droplevel(1)\n",
        "\n",
        "    if date_str:\n",
        "        target_date = datetime.strptime(date_str, \"%Y-%m-%d\").date()\n",
        "    else:\n",
        "        target_date = datetime.now(HK_TZ).date()\n",
        "\n",
        "    hsi_today = hsi[hsi.index.date == target_date]\n",
        "    hsi_today = hsi_today.between_time(\"09:30\", \"16:00\")\n",
        "\n",
        "    if hsi_today.empty:\n",
        "        print(f\"⚠️ {target_date} 無數據，可能係非交易日\")\n",
        "        return None, None, None, None\n",
        "\n",
        "    ss_filtered = ss[ss.index.date <= target_date]\n",
        "    if len(ss_filtered) >= 2:\n",
        "        today_close = float(ss_filtered[\"Close\"].iloc[-1])\n",
        "        prev_close  = float(ss_filtered[\"Close\"].iloc[-2])\n",
        "        a_chg = (today_close - prev_close) / prev_close * 100\n",
        "    elif len(ss_filtered) == 1:\n",
        "        today_close = float(ss_filtered[\"Close\"].iloc[-1])\n",
        "        today_open  = float(ss_filtered[\"Open\"].iloc[-1])\n",
        "        a_chg = (today_close - today_open) / today_open * 100\n",
        "    else:\n",
        "        a_chg = 0\n",
        "\n",
        "    print(f\"✅ 數據下載完成: {target_date}\")\n",
        "    print(f\"   HSI數據點: {len(hsi_today)} 個15分鐘bar\")\n",
        "    print(f\"   A股變動: {a_chg:.2f}%\")\n",
        "\n",
        "    return hsi_today, hsi_daily, a_chg, target_date\n",
        "\n",
        "# ============================================================\n",
        "# 突變檢測\n",
        "# ============================================================\n",
        "def detect_sudden_change(df_slice, prev_close=None):\n",
        "    if len(df_slice) < 2:\n",
        "        return False, None, 0\n",
        "\n",
        "    current_bar    = df_slice.iloc[-1]\n",
        "    prev_bar       = df_slice.iloc[-2]\n",
        "    current_close  = float(current_bar[\"Close\"])\n",
        "    prev_close_bar = float(prev_bar[\"Close\"])\n",
        "    current_high   = float(current_bar[\"High\"])\n",
        "    current_low    = float(current_bar[\"Low\"])\n",
        "    current_open   = float(current_bar[\"Open\"])\n",
        "\n",
        "    bar_change_pct = abs(current_close - prev_close_bar) / prev_close_bar * 100\n",
        "    bar_range_pct  = (current_high - current_low) / current_open * 100\n",
        "\n",
        "    reasons   = []\n",
        "    magnitude = 0\n",
        "\n",
        "    if bar_change_pct >= SUDDEN_CHANGE_THRESHOLD:\n",
        "        direction = \"急升\" if current_close > prev_close_bar else \"急跌\"\n",
        "        reasons.append(f\"價格{direction} {bar_change_pct:.2f}%\")\n",
        "        magnitude = max(magnitude, bar_change_pct)\n",
        "\n",
        "    if bar_range_pct >= SUDDEN_RANGE_THRESHOLD:\n",
        "        reasons.append(f\"單bar波幅 {bar_range_pct:.2f}%\")\n",
        "        magnitude = max(magnitude, bar_range_pct)\n",
        "\n",
        "    if reasons:\n",
        "        return True, \" | \".join(reasons), magnitude\n",
        "\n",
        "    return False, None, 0\n",
        "\n",
        "# ============================================================\n",
        "# 技術指標\n",
        "# ============================================================\n",
        "def calc_vwap(df):\n",
        "    try:\n",
        "        tp = (df[\"High\"] + df[\"Low\"] + df[\"Close\"]) / 3\n",
        "        return float(tp.mean())\n",
        "    except:\n",
        "        return None\n",
        "\n",
        "def calc_rsi(series, period=6):\n",
        "    delta = series.diff()\n",
        "    gain  = delta.clip(lower=0).rolling(period).mean()\n",
        "    loss  = -delta.clip(upper=0).rolling(period).mean()\n",
        "    rs    = gain / loss\n",
        "    return 100 - (100 / (1 + rs))\n",
        "\n",
        "def calc_volatility_signal(df, hsi_daily):\n",
        "    try:\n",
        "        avg_range   = float((hsi_daily[\"High\"] - hsi_daily[\"Low\"]).mean())\n",
        "        today_range = float(df[\"High\"].max() - df[\"Low\"].min())\n",
        "        ratio       = today_range / avg_range if avg_range > 0 else 1\n",
        "        return today_range, avg_range, ratio\n",
        "    except:\n",
        "        return 0, 1, 1\n",
        "\n",
        "# ============================================================\n",
        "# 技術信號計算（中文信號）\n",
        "# ============================================================\n",
        "def calc_signal(df_slice, hsi_daily, a_chg):\n",
        "    score   = 0\n",
        "    reasons = []\n",
        "\n",
        "    close_series = df_slice[\"Close\"].squeeze()\n",
        "    last_price   = float(close_series.iloc[-1])\n",
        "    day_high     = float(df_slice[\"High\"].max())\n",
        "    day_low      = float(df_slice[\"Low\"].min())\n",
        "    day_open     = float(df_slice[\"Open\"].iloc[0])\n",
        "\n",
        "    # VWAP\n",
        "    vwap = calc_vwap(df_slice)\n",
        "    if vwap:\n",
        "        if last_price > vwap * 1.001:\n",
        "            score += 1\n",
        "            reasons.append(f\"✅ 現價({last_price:.0f}) > VWAP({vwap:.0f}) +1\")\n",
        "        elif last_price < vwap * 0.999:\n",
        "            score -= 1\n",
        "            reasons.append(f\"🔴 現價({last_price:.0f}) < VWAP({vwap:.0f}) -1\")\n",
        "        else:\n",
        "            reasons.append(f\"➡️ 現價≈VWAP({vwap:.0f}) 中性\")\n",
        "    else:\n",
        "        vwap = last_price\n",
        "\n",
        "    # A股\n",
        "    if a_chg > 0.3:\n",
        "        score += 1\n",
        "        reasons.append(f\"✅ A股升{a_chg:.2f}% +1\")\n",
        "    elif a_chg < -0.3:\n",
        "        score -= 1\n",
        "        reasons.append(f\"🔴 A股跌{a_chg:.2f}% -1\")\n",
        "    else:\n",
        "        reasons.append(f\"➡️ A股變動{a_chg:.2f}% 中性\")\n",
        "\n",
        "    # 波幅\n",
        "    today_range, avg_range, ratio = calc_volatility_signal(df_slice, hsi_daily)\n",
        "    if ratio > 1.2:\n",
        "        score += 1\n",
        "        reasons.append(f\"✅ 波幅{today_range:.0f}點({ratio:.1f}x) 可信 +1\")\n",
        "    elif ratio < 0.6:\n",
        "        score -= 1\n",
        "        reasons.append(f\"🔴 波幅{today_range:.0f}點({ratio:.1f}x) 窄幅 -1\")\n",
        "    else:\n",
        "        reasons.append(f\"➡️ 波幅{today_range:.0f}點({ratio:.1f}x) 中性\")\n",
        "\n",
        "    # RSI\n",
        "    rsi_series = calc_rsi(close_series, period=6)\n",
        "    rsi = float(rsi_series.iloc[-1]) if not pd.isna(rsi_series.iloc[-1]) else 50\n",
        "    if rsi > 70:\n",
        "        score -= 1\n",
        "        reasons.append(f\"⚠️ RSI超買({rsi:.1f}) -1\")\n",
        "    elif rsi < 30:\n",
        "        score -= 1\n",
        "        reasons.append(f\"⚠️ RSI超賣({rsi:.1f}) -1\")\n",
        "    else:\n",
        "        reasons.append(f\"➡️ RSI正常({rsi:.1f})\")\n",
        "\n",
        "    # MA5 趨勢\n",
        "    if len(close_series) >= 5:\n",
        "        ma5 = float(close_series.rolling(5).mean().iloc[-1])\n",
        "        if last_price > ma5:\n",
        "            score += 1\n",
        "            reasons.append(f\"✅ 現價 > MA5({ma5:.0f}) 上升趨勢 +1\")\n",
        "        else:\n",
        "            score -= 1\n",
        "            reasons.append(f\"🔴 現價 < MA5({ma5:.0f}) 下跌趨勢 -1\")\n",
        "    else:\n",
        "        ma5 = last_price\n",
        "\n",
        "    # 尾段強弱\n",
        "    if len(close_series) >= 4:\n",
        "        early_avg = float(close_series.iloc[:2].mean())\n",
        "        late_avg  = float(close_series.iloc[-2:].mean())\n",
        "        if late_avg > early_avg * 1.001:\n",
        "            score += 1\n",
        "            reasons.append(f\"✅ 尾段走強({late_avg:.0f} vs {early_avg:.0f}) +1\")\n",
        "        elif late_avg < early_avg * 0.999:\n",
        "            score -= 1\n",
        "            reasons.append(f\"🔴 尾段走弱({late_avg:.0f} vs {early_avg:.0f}) -1\")\n",
        "        else:\n",
        "            reasons.append(f\"➡️ 首尾持平\")\n",
        "\n",
        "    # ── 中文信號 ──\n",
        "    if score >= 3:\n",
        "        signal      = \"🟢 買入\"\n",
        "        action      = \"買入\"\n",
        "        stop_loss   = round(day_low - 30, 0)\n",
        "        take_profit = round(last_price + (last_price - stop_loss) * 1.5, 0)\n",
        "    elif score <= -3:\n",
        "        signal      = \"🔴 賣出/做空\"\n",
        "        action      = \"賣出\"\n",
        "        stop_loss   = round(day_high + 30, 0)\n",
        "        take_profit = round(last_price - (stop_loss - last_price) * 1.5, 0)\n",
        "    else:\n",
        "        signal      = \"⬜ 觀望/持倉\"\n",
        "        action      = \"觀望\"\n",
        "        stop_loss   = None\n",
        "        take_profit = None\n",
        "\n",
        "    return signal, score, reasons, last_price, vwap, rsi, \\\n",
        "           day_high, day_low, day_open, action, stop_loss, take_profit\n",
        "\n",
        "# ============================================================\n",
        "# AI 分析\n",
        "# ============================================================\n",
        "def ai_analysis(signal, score, reasons, hsi_price, vwap, a_share_chg,\n",
        "                day_high, day_low, day_open, rsi, session,\n",
        "                sim_time, trigger_type, sudden_reason=None):\n",
        "\n",
        "    if trigger_type == \"突變\":\n",
        "        focus = f\"緊急分析：剛剛發生突變（{sudden_reason}），評估影響及後續走勢\"\n",
        "    elif session in [\"早市\", \"午休\"]:\n",
        "        focus = \"預測下午走勢方向\"\n",
        "    else:\n",
        "        focus = \"分析當前走勢，預測收市前方向\"\n",
        "\n",
        "    prompt = f\"\"\"\n",
        "你係一個香港股票市場分析師，專門分析恒生指數（HSI）走勢。\n",
        "請用繁體中文，簡潔地回答。\n",
        "\n",
        "=== 觸發類型：{trigger_type} ===\n",
        "時段：{session}\n",
        "分析目標：{focus}\n",
        "時間: {sim_time}\n",
        "{\"⚠️ 突變原因: \" + sudden_reason if sudden_reason else \"\"}\n",
        "\n",
        "=== 市場數據 ===\n",
        "HSI現價:       {hsi_price:.0f}\n",
        "開市價:        {day_open:.0f}\n",
        "當前最高:      {day_high:.0f}\n",
        "當前最低:      {day_low:.0f}\n",
        "VWAP:          {vwap:.0f}\n",
        "RSI(6):        {rsi:.1f}\n",
        "A股(上證)變動: {a_share_chg:.2f}%\n",
        "\n",
        "=== 系統信號 ===\n",
        "預測信號: {signal}\n",
        "總分: {score}/6\n",
        "信號明細:\n",
        "{chr(10).join(reasons)}\n",
        "\n",
        "=== 請提供 ===\n",
        "1. {\"突變成因分析（1句）\" if trigger_type == \"突變\" else \"走勢觀察重點（2點）\"}\n",
        "2. 關鍵價位（上方阻力、下方支撐各1個）\n",
        "3. 風險提示（1句）\n",
        "4. 信心水平（高/中/低）+ 原因1句\n",
        "\n",
        "格式簡潔，唔需要廢話。\n",
        "\"\"\"\n",
        "    try:\n",
        "        response = ai_client.chat.completions.create(\n",
        "            model=AI_MODEL,\n",
        "            messages=[{\"role\": \"user\", \"content\": prompt}],\n",
        "            temperature=0.3\n",
        "        )\n",
        "        return response.choices[0].message.content\n",
        "    except Exception as e:\n",
        "        err = str(e)\n",
        "        if \"402\" in err or \"quota\" in err.lower():\n",
        "            return \"（AI額度用完）\"\n",
        "        return f\"AI分析失敗: {e}\"\n",
        "\n",
        "# ============================================================\n",
        "# 實際下午表現（Backtest用）\n",
        "# ============================================================\n",
        "def calc_actual_performance(hsi_today):\n",
        "    try:\n",
        "        morning   = hsi_today.between_time(\"09:30\", \"12:00\")\n",
        "        afternoon = hsi_today.between_time(\"13:00\", \"16:00\")\n",
        "        if morning.empty or afternoon.empty:\n",
        "            return None, None, None\n",
        "        morning_close   = float(morning[\"Close\"].iloc[-1])\n",
        "        afternoon_close = float(afternoon[\"Close\"].iloc[-1])\n",
        "        afternoon_high  = float(afternoon[\"High\"].max())\n",
        "        afternoon_low   = float(afternoon[\"Low\"].min())\n",
        "        change_pct      = (afternoon_close - morning_close) / morning_close * 100\n",
        "        if change_pct > 0.2:\n",
        "            actual = \"🟢 買入\"\n",
        "        elif change_pct < -0.2:\n",
        "            actual = \"🔴 賣出/做空\"\n",
        "        else:\n",
        "            actual = \"⬜ 觀望/持倉\"\n",
        "        return actual, change_pct, {\n",
        "            \"morning_close\"  : morning_close,\n",
        "            \"afternoon_high\" : afternoon_high,\n",
        "            \"afternoon_low\"  : afternoon_low,\n",
        "            \"afternoon_close\": afternoon_close\n",
        "        }\n",
        "    except:\n",
        "        return None, None, None\n",
        "\n",
        "# ============================================================\n",
        "# 實時監控（每1分鐘，rolling 15分鐘）← 新增\n",
        "# ============================================================\n",
        "def run_live_monitor():\n",
        "    \"\"\"\n",
        "    每1分鐘下載最新數據，用過去rolling 15根1m bar計算信號\n",
        "    \"\"\"\n",
        "    print(\"=\" * 60)\n",
        "    print(\"  HSI 實時監控 v5.3 — 每1分鐘滾動15分鐘信號\")\n",
        "    print(f\"  AI定時: {', '.join(SCHEDULED_AI_TIMES)}\")\n",
        "    print(f\"  突變閾值: 價格>{SUDDEN_CHANGE_THRESHOLD}% | 波幅>{SUDDEN_RANGE_THRESHOLD}%\")\n",
        "    print(\"  按 Ctrl+C 停止\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    last_signal  = None\n",
        "    last_ai_time = None\n",
        "\n",
        "    while True:\n",
        "        now_hk = datetime.now(HK_TZ)\n",
        "        t      = now_hk.time()\n",
        "\n",
        "        in_morning   = time(9, 30) <= t <= time(12, 0)\n",
        "        in_afternoon = time(13, 0) <= t <= time(16, 0)\n",
        "\n",
        "        if not (in_morning or in_afternoon):\n",
        "            next_open = \"13:00\" if time(12, 0) < t < time(13, 0) else \"明日09:30\"\n",
        "            print(f\"[{t.strftime('%H:%M')}] 休市中，下次開市: {next_open}\")\n",
        "            time_module.sleep(60)\n",
        "            continue\n",
        "\n",
        "        # ── 下載1分鐘數據 ──\n",
        "        try:\n",
        "            hsi_raw = yf.download(\"^HSI\", period=\"1d\", interval=\"1m\", progress=False)\n",
        "            hsi_raw.index = hsi_raw.index.tz_convert(HK_TZ)\n",
        "            if isinstance(hsi_raw.columns, pd.MultiIndex):\n",
        "                hsi_raw.columns = hsi_raw.columns.droplevel(1)\n",
        "\n",
        "            today        = now_hk.date()\n",
        "            hsi_today_1m = hsi_raw[hsi_raw.index.date == today]\n",
        "            hsi_today_1m = hsi_today_1m.between_time(\"09:30\", \"16:00\")\n",
        "\n",
        "            hsi_daily = yf.download(\"^HSI\", period=\"30d\", interval=\"1d\", progress=False)\n",
        "            if isinstance(hsi_daily.columns, pd.MultiIndex):\n",
        "                hsi_daily.columns = hsi_daily.columns.droplevel(1)\n",
        "\n",
        "            ss = yf.download(\"000001.SS\", period=\"5d\", interval=\"1d\", progress=False)\n",
        "            if isinstance(ss.columns, pd.MultiIndex):\n",
        "                ss.columns = ss.columns.droplevel(1)\n",
        "            ss_filtered = ss[ss.index.date <= today]\n",
        "            if len(ss_filtered) >= 2:\n",
        "                a_chg = (float(ss_filtered[\"Close\"].iloc[-1]) - float(ss_filtered[\"Close\"].iloc[-2])) \\\n",
        "                        / float(ss_filtered[\"Close\"].iloc[-2]) * 100\n",
        "            else:\n",
        "                a_chg = 0\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"⚠️ 數據下載失敗: {e}\")\n",
        "            time_module.sleep(60)\n",
        "            continue\n",
        "\n",
        "        if hsi_today_1m.empty or len(hsi_today_1m) < 2:\n",
        "            print(f\"[{t.strftime('%H:%M')}] 數據不足，等待中...\")\n",
        "            time_module.sleep(60)\n",
        "            continue\n",
        "\n",
        "        # ── Rolling 15分鐘切片 ──\n",
        "        df_slice = hsi_today_1m.tail(15)\n",
        "        if len(df_slice) < 2:\n",
        "            time_module.sleep(60)\n",
        "            continue\n",
        "\n",
        "        sim_time_str = now_hk.strftime(\"%H:%M\")\n",
        "        session      = \"早市\" if in_morning else \"下午\"\n",
        "\n",
        "        # ── 計算信號 ──\n",
        "        signal, score, reasons, price, vwap, rsi, \\\n",
        "        d_high, d_low, d_open, action, sl, tp = calc_signal(df_slice, hsi_daily, a_chg)\n",
        "\n",
        "        # ── 突變檢測 ──\n",
        "        is_sudden, sudden_reason, magnitude = detect_sudden_change(df_slice)\n",
        "\n",
        "        # ── 打印邏輯：信號改變 or 突變 才全印 ──\n",
        "        signal_changed = (signal != last_signal)\n",
        "\n",
        "        if signal_changed or is_sudden:\n",
        "            print(f\"\\n{'='*60}\")\n",
        "            if is_sudden:\n",
        "                print(f\"⚡ [{sim_time_str}] {session} — 突變警報！{sudden_reason}\")\n",
        "            elif signal_changed:\n",
        "                print(f\"🔔 [{sim_time_str}] {session} — 信號改變！\")\n",
        "            print(f\"  信號    : {signal}\")\n",
        "            print(f\"  總分    : {score}/6\")\n",
        "            print(f\"  現價    : {price:.0f}   VWAP: {vwap:.0f}   RSI: {rsi:.1f}\")\n",
        "            print(f\"  A股變動 : {a_chg:+.2f}%\")\n",
        "\n",
        "            if action in [\"買入\", \"賣出\"]:\n",
        "                print(f\"  ─────────────────────────────\")\n",
        "                print(f\"  入場價  : {price:.0f}\")\n",
        "                print(f\"  止損位  : {sl:.0f}\")\n",
        "                print(f\"  目標價  : {tp:.0f}\")\n",
        "                rr = abs(tp - price) / abs(price - sl) if sl and (price - sl) != 0 else 0\n",
        "                print(f\"  風險回報: 1 : {rr:.1f}\")\n",
        "\n",
        "            print(f\"  ─────────────────────────────\")\n",
        "            print(f\"  信號明細:\")\n",
        "            for r in reasons:\n",
        "                print(f\"    {r}\")\n",
        "\n",
        "            last_signal = signal\n",
        "\n",
        "        else:\n",
        "            # 信號未變，只打印一行\n",
        "            print(f\"[{sim_time_str}] {signal} | 現價: {price:.0f} | 分數: {score}/6\")\n",
        "\n",
        "        # ── AI調用 ──\n",
        "        is_scheduled   = sim_time_str in SCHEDULED_AI_TIMES\n",
        "        should_call_ai = is_scheduled or is_sudden\n",
        "\n",
        "        if should_call_ai and sim_time_str != last_ai_time:\n",
        "            trigger = \"定時+突變\" if (is_scheduled and is_sudden) \\\n",
        "                      else (\"突變\" if is_sudden else \"定時\")\n",
        "            print(f\"\\n  🤖 請自己用 AI分析中 ({trigger})...\")\n",
        "            # ai_result = ai_analysis(signal, score, reasons, price, vwap, a_chg,d_high, d_low, d_open, rsi, session,sim_time_str, trigger, sudden_reason)\n",
        "            # print(f\"\\n  {ai_result.replace(chr(10), chr(10)+'  ')}\")\n",
        "            last_ai_time = sim_time_str\n",
        "\n",
        "        time_module.sleep(60)\n",
        "\n",
        "# ============================================================\n",
        "# Backtest 主函數（保留原本）\n",
        "# ============================================================\n",
        "def run_backtest(date_str=None, speed=\"fast\"):\n",
        "    print(\"=\" * 60)\n",
        "    print(\"  HSI 預測系統 v5.3 - BACKTEST模式\")\n",
        "    print(f\"  AI模型: {AI_MODEL}\")\n",
        "    print(f\"  定時AI: {', '.join(SCHEDULED_AI_TIMES)}\")\n",
        "    print(f\"  突變閾值: 價格變動>{SUDDEN_CHANGE_THRESHOLD}% 或波幅>{SUDDEN_RANGE_THRESHOLD}%\")\n",
