        "# ============================================================\n",
        "# HMM 收斂驗證輔助函數\n",
        "# ============================================================\n",
        "def _fit_hmm_with_convergence_check(\n",
        "    hmm_model, X, ticker: str = \"\"\n",
        ") -> bool:\n",
        "    \"\"\"\n",
        "    fit HMM 並驗證收斂。\n",
        "    返回 True = 正常收斂，False = 達到 n_iter 上限（未必收斂）。\n",
        "    \"\"\"\n",
        "    hmm_model.fit(X)\n",
        "    monitor = hmm_model.monitor_\n",
        "    converged = monitor.converged\n",
        "    iters     = len(monitor.history)\n",
        "    if not converged:\n",
        "        print(\n",
        "            f\"  ⚠️  HMM {'['+ticker+']' if ticker else ''} \"\n",
        "            f\"未收斂（{iters} iters / n_iter={hmm_model.n_iter}）\"\n",
        "            f\"，考慮增加 HMM_N_ITER\"\n",
        "        )\n",
        "    return converged\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 多 Seed Vol-Surge Ensemble（替代資金流主力信號）\n",
        "# ============================================================\n",
        "def _vol_surge_ensemble(vol: pd.Series, window: int) -> pd.Series:\n",
        "    \"\"\"\n",
        "    用多 seed bootstrap 抽樣計算 vol_surge 的穩定估計。\n",
        "    實質：多次 rolling mean（固定計算，seed 用於 bootstrap CI 估計）。\n",
        "    等效於直接 rolling mean，但保留擴展空間。\n",
        "    \"\"\"\n",
        "    base = vol / (vol.rolling(window, min_periods=window // 2).mean() + 1e-9)\n",
        "    # 多 seed 結果一致（rolling 係 deterministic），直接返回\n",
        "    # 若未來改用 bootstrap resample，此處擴展\n",
        "    return base\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 主特徵工程函數\n",
