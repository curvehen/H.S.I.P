        "                        continue\n",
        "                    try:\n",
        "                        regime_models[regime] = train_lgbm(\n",
        "                            Xr_tr, yr_tr, Xr_val, yr_val\n",
        "                        )\n",
        "                    except Exception:\n",
        "                        pass\n",
        "\n",
        "                drift.fit_ref(retrain_df[feat_cols].iloc[-252:])\n",
        "\n",
        "            except Exception as e:\n",
