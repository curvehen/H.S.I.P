        "# @title\n",
        "# ============================================================\n",
        "# Cell 14: 預測歷史記錄查閱\n",
        "# 查看過去每日預測 vs 實際結果\n",
        "# ============================================================\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import os\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"  📋 預測歷史記錄\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "log_path = \"results/prediction_log.csv\"\n",
        "\n",
        "if os.path.exists(log_path):\n",
        "    log_df = pd.read_csv(log_path)\n",
        "    # ✅ 修正版\n",
        "    log_df[\"run_time\"] = pd.to_datetime(\n",
        "        log_df[\"run_time\"].astype(str)\n",
