        "    strategy_ret   = (\"strategy_ret\",   lambda x: (1+x).prod()-1),\n",
        "    bh_ret         = (\"bh_ret\",         lambda x: (1+x).prod()-1),\n",
        "    avg_prob       = (\"ensemble_prob\",  \"mean\"),\n",
        "    retrain_count  = (\"retrain\",        \"sum\"),\n",
        "    direction_acc  = (\"correct\",        lambda x: x.dropna().mean()),\n",
        ").reset_index()\n",
        "\n",
        "monthly[\"excess_ret\"] = monthly[\"strategy_ret\"] - monthly[\"bh_ret\"]\n",
        "monthly[\"month_str\"]  = monthly[\"month\"].astype(str)\n",
        "\n",
        "print(f\"\\n{'Month':>10} {'Trade Days':>10} {'Signal Days':>11} \"\n",
        "      f\"{'Strat Ret':>9} {'BH Ret':>8} {'Excess':>8} \"\n",
        "      f\"{'Hit Rate':>8} {'Retrain':>8}\")\n",
        "print(\"-\" * 80)\n",
        "\n",
