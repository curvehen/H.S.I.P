        "\n",
        "def classify_market_regime(df_slice):\n",
        "    \"\"\"\n",
        "    判斷市場狀態：趨勢市 or 震盪市\n",
        "    轉折點只在震盪市有效\n",
        "    \"\"\"\n",
        "    close = df_slice[\"Close\"].squeeze()\n",
        "\n",
        "    if len(close) < 10:\n",
        "        return \"未知\", 0\n",
        "\n",
        "    # ATR-based 波動率\n",
        "    high  = df_slice[\"High\"].squeeze()\n",
        "    low   = df_slice[\"Low\"].squeeze()\n",
        "    atr   = float((high - low).rolling(5).mean().iloc[-1])\n",
        "    price = float(close.iloc[-1])\n",
        "    atr_pct = atr / price * 100\n",
        "\n",
        "    # ADX-like 趨勢強度（用MA斜率代替）\n",
        "    ma5  = close.rolling(5).mean()\n",
        "    ma10 = close.rolling(10).mean()\n",
        "\n",
        "    if len(ma10.dropna()) < 2:\n",
        "        return \"未知\", atr_pct\n",
        "\n",
        "    ma5_slope  = float(ma5.iloc[-1] - ma5.iloc[-3]) / float(ma5.iloc[-3]) * 100\n",
        "    ma10_slope = float(ma10.iloc[-1] - ma10.iloc[-3]) / float(ma10.iloc[-3]) * 100\n",
        "\n",
        "    # 趨勢市：MA斜率大 + 價格在MA同側\n",
        "    if abs(ma5_slope) > 0.3 and abs(ma10_slope) > 0.2:\n",
        "        regime = \"趨勢市📈\" if ma5_slope > 0 else \"趨勢市📉\"\n",
        "    else:\n",
        "        regime = \"震盪市↔️\"\n",
        "\n",
        "    return regime, atr_pct\n",
        "\n",
        "\n",
