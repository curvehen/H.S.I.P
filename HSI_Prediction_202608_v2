        "    for ticker, df in stock_feat_data.items():\n",
        "        if df is None or len(df) == 0 or \"date\" not in df.columns:\n",
        "            continue\n",
        "        _df = df.copy()\n",
        "        if \"ticker\" not in _df.columns: _df.insert(0, \"ticker\", ticker)\n",
        "        if \"name\"   not in _df.columns: _df.insert(1, \"name\",   _sl.get(ticker, ticker))\n",
