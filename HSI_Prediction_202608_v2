        "        hour=MARKET_OPEN_H, minute=MARKET_OPEN_M,\n",
        "        second=0, microsecond=0\n",
        "    ).time()\n",
        "    close_t = dt.replace(\n",
        "        hour=MARKET_CLOSE_H, minute=MARKET_CLOSE_M,\n",
        "        second=0, microsecond=0\n",
        "    ).time()\n",
        "    return open_t <= t < close_t\n",
        "\n",
        "\n",
        "def is_after_close(dt):\n",
        "    \"\"\"\n",
        "    係咪收市後\n",
        "    港股收市：16:00 HKT\n",
        "    \"\"\"\n",
        "    if not is_weekday(dt):\n",
