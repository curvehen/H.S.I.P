        "    acc_str = f\"{row['direction_acc']:.1%}\" \\\n",
        "              if not pd.isna(row[\"direction_acc\"]) else \"    N/A\"\n",
        "    excess_color = \"+\" if row[\"excess_ret\"] >= 0 else \"\"\n",
        "    print(f\"  {row['month_str']:>8} \"\n",
        "          f\"{int(row['trading_days']):>10} \"\n",
        "          f\"{int(row['signal_days']):>11} \"\n",
        "          f\"{row['strategy_ret']:>+9.2%} \"\n",
        "          f\"{row['bh_ret']:>+8.2%} \"\n",
        "          f\"{excess_color}{row['excess_ret']:>7.2%} \"\n",
