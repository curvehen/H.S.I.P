        "    df = df.merge(hsi_feat, on=\"date\", how=\"left\")\n",
        "\n",
        "    # ── 相對強弱特徵 ──────────────────────────────────────────\n",
        "    if \"hsi_ret_1d\" in df.columns:\n",
        "        df[\"rel_ret_1d\"]  = df[\"ret_1d\"] - df[\"hsi_ret_1d\"]\n",
        "        df[\"rel_ret_5d\"]  = (\n",
        "            df[\"ret_5d\"] - df[\"hsi_ret_5d\"]\n",
        "            if \"hsi_ret_5d\" in df.columns else df[\"ret_5d\"]\n",
